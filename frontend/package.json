{
  "name": "gleason-platform-frontend",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test:core": "rm -rf .phase1-test-build && tsc -p tsconfig.core.json && node --test tests/*.test.mjs",
    "check:sw": "node --check public/sw.js",
    "cap:sync": "npx cap sync",
    "cap:android": "npx cap open android",
    "cap:ios": "npx cap open ios",
    "test:e2e": "playwright test",
    "test:pwa": "node --test tests/pwa/*.test.mjs"
  },
  "dependencies": {
    "@capacitor/core": "7.6.9",
    "geographiclib-geodesic": "2.2.0",
    "ol": "10.10.0",
    "proj4": "2.22.0",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "topojson-client": "3.1.0",
    "world-atlas": "2.0.2"
  },
  "devDependencies": {
    "@capacitor/android": "7.6.9",
    "@capacitor/cli": "7.6.9",
    "@capacitor/ios": "7.6.9",
    "@playwright/test": "1.63.0",
    "@types/react": "19.0.0",
    "@types/react-dom": "19.0.0",
    "@types/topojson-client": "3.1.5",
    "@vitejs/plugin-react": "4.4.0",
    "typescript": "5.8.3",
    "vite": "6.4.3"
  }
}
